# Copy to .env.local and adjust.
DATABASE_PATH=./data/store.db
MEDIA_DIR=./data/media
SITE_URL=http://localhost:3000
# Optional: enables the "Fill for me" helper in the product form.
ANTHROPIC_API_KEY=
# Optional: model for "Fill for me" (default claude-opus-5-5). claude-haiku-5-5 costs far less per product.
AUTOFILL_MODEL=
